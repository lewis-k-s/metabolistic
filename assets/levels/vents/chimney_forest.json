  "mobs": {
    "chimney_lurker": {
      "label": "Chimney lurker",
      "archetype": "Predator",
      "proposed": "Stays still in the cold lee under a chimney; lunges at a cell that passes within 80 px, then drifts back.",
      "notes": "Runs as the normal engulfer until the ambush behaviour exists."
    },
    "pigment_bacillus": {
      "label": "Pigmented bacillus",
      "archetype": "Prey",
      "signature": "SecondaryMetabolites",
      "notes": "Carries the pigment gene (UV shield). Waits in the dim edge under a light shaft. Engulf one to take the gene."
    },
    "smoker_bacillus": {
      "label": "Smoker bacillus",
      "archetype": "Prey",
      "proposed": "Gathers in the warm rim just above a chimney mouth and scatters when a bigger cell comes close.",
      "notes": "The food of the level: always near a jet, so catching one means working near the burn line."
    },
    "symbiont": {
      "label": "Symbiont",
      "archetype": "Symbiont",
      "notes": "Follows the player once it senses it; trades carbon for ATP on contact."
    }
