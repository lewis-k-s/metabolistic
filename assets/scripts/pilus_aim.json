{
  "scenario": "vent_predator",
  "log_every": 0.5,
  "steps": [
    { "at": 0.5, "shot": "0-start" },
    { "at": 1.0, "aim": [100, 0] },
    { "at": 1.3, "expect": { "aim": [1, 0] } },
    { "at": 1.4, "aim": [0, 100] },
    { "at": 1.7, "expect": { "aim": [0, 1] } },
    { "at": 1.7, "shot": "1-aim-up" },
    { "at": 2.0, "aim_nearest_cell": true },
    { "at": 2.3, "press": "Left" },
    { "at": 2.6, "shot": "2-pilus-shot" },
    { "at": 3.0, "expect": { "pilus": "attached" } },
    { "at": 3.0, "wheel": -5 },
    { "at": 4.0, "log": "after reel in" },
    { "at": 4.0, "shot": "3-reeled" },
    { "at": 4.5, "release": "Left" },
    { "at": 5.0, "expect": { "pilus": "in" } },
    { "at": 5.0, "shot": "4-released" },
    { "at": 5.5, "exit": 0 }
  ]
}
